<?xml version="1.0" encoding="utf-8"?>
<!-- Simple camera-lens icon reminiscent of Instagram -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer rounded square gradient fill -->
    <path
        android:fillColor="#833AB4"
        android:pathData="M54,12 C31,12 12,31 12,54 C12,77 31,96 54,96 C77,96 96,77 96,54 C96,31 77,12 54,12Z" />

    <!-- Camera lens ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:pathData="M54,38 A16,16 0 1,1 53.99,38Z" />

    <!-- Lens centre dot -->
    <circle
        android:fillColor="#FFFFFF"
        android:cx="54"
        android:cy="54"
        android:r="6" />

    <!-- Top-right flash dot -->
    <circle
        android:fillColor="#FFFFFF"
        android:cx="74"
        android:cy="34"
        android:r="3" />
</vector>
